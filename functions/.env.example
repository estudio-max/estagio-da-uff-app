# Copie para functions/.env.<id-do-projeto> (ex.: .env.estagiosuff) e preencha. Não é segredo, mas não vai ao repositório.
GRUPO_EMAIL=estagios.uff@id.uff.br
DOMINIO_PERMITIDO=id.uff.br
# Conta de serviço com a delegação em todo o domínio já autorizada no Google Admin
DIRECTORY_SA=<conta-de-servico>@<projeto>.iam.gserviceaccount.com
# Administrador do Workspace que a delegação representa (só leitura); idealmente uma conta dedicada
DIRECTORY_SUBJECT=<administrador>@id.uff.br
# Papéis do grupo que dão acesso ao sistema (padrão: os três)
PAPEIS_COM_ACESSO=OWNER,MANAGER,MEMBER
