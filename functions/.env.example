# Copie para functions/.env.<id-do-projeto> (ex.: .env.estagiosuff) e preencha. Não é segredo, mas não vai ao repositório.
DOMINIO_PERMITIDO=id.uff.br
# Papéis do grupo que dão acesso ao sistema (padrão: os três)
PAPEIS_COM_ACESSO=OWNER,MANAGER,MEMBER

# Escolha UMA fonte de "quem pode entrar". Precedência: lista > API do grupo > Directory API.

# 1) Ponte provisória: lista de e-mails (papel opcional; sem papel vale MEMBER)
EMAILS_AUTORIZADOS=cosme@id.uff.br:OWNER,ana@id.uff.br

# 2) API do grupo no Cloud Run (docs/API-GRUPO.md)
# DIRECTORY_API_URL=https://<servico>.a.run.app/grupos/estagios/membros

# 3) Directory API direto, com delegação em todo o domínio (docs/CONFIGURAR-GRUPO.md)
# GRUPO_EMAIL=estagios.uff@id.uff.br
# DIRECTORY_SA=<conta-de-servico>@<projeto>.iam.gserviceaccount.com
# DIRECTORY_SUBJECT=<administrador-dedicado>@id.uff.br
